---
import { translations, localeLabels, localeNames } from '../i18n/translations';
import type { Locale } from '../i18n/translations';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const localeFlags: Record<Locale, string> = {
  'en':    '🇺🇸',
  'pt-br': '🇧🇷',
  'es':    '🇪🇸',
  'zh':    '🇨🇳',
  'it':    '🇮🇹',
};
---

<header class="header" id="header">
  <div class="container nav-inner">

    <!-- Logo -->
    <a href="/" class="nav-logo">Matheus Palmieri</a>

    <!-- Right controls -->
    <div class="nav-controls">

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        class="theme-btn"
        aria-label="Toggle theme"
        title="Toggle dark/light mode"
      >
        <!-- Sun: visible in dark mode -->
        <svg id="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <!-- Moon: visible in light mode -->
        <svg id="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <!-- Language selector -->
      <div class="lang-selector" id="lang-selector">
        <button class="lang-current" id="lang-btn" aria-haspopup="listbox" aria-expanded="false">
          <span class="lang-flag-current">{localeFlags[lang]}</span>
          <span class="lang-label">{localeLabels[lang]}</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="chevron">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>

        <ul class="lang-dropdown" role="listbox" id="lang-dropdown">
          {Object.entries(localeLabels).map(([code, label]) => (
            <li
              role="option"
              data-lang={code}
              class={`lang-option ${code === lang ? 'active' : ''}`}
              aria-selected={code === lang}
            >
              <span class="lang-flag">{localeFlags[code as Locale]}</span>
              <div class="lang-text">
                <span class="lang-code">{label}</span>
                <span class="lang-name">{localeNames[code as Locale]}</span>
              </div>
              {code === lang && (
                <svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              )}
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</header>

<style>
  /* ─── Header shell ──────────────────────────────────────────────────────── */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }

  .header.scrolled {
    border-bottom-color: var(--color-border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    gap: 1rem;
  }

  /* ─── Logo ──────────────────────────────────────────────────────────────── */
  .nav-logo {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text);
    letter-spacing: -0.01em;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.2s;
  }
  .nav-logo:hover { opacity: 0.7; }

  /* ─── Right controls ────────────────────────────────────────────────────── */
  .nav-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  /* ─── Theme button ──────────────────────────────────────────────────────── */
  .theme-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .theme-btn:hover {
    color: var(--color-text);
    background: var(--color-skill-bg);
    transform: scale(1.05);
  }

  .theme-btn:active {
    transform: scale(0.95);
  }

  /* ─── Language selector ─────────────────────────────────────────────────── */
  .lang-selector {
    position: relative;
  }

  .lang-current {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0 0.75rem;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    font-size: 0.82rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    height: 40px;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .lang-current:hover {
    background: var(--color-skill-bg);
    border-color: var(--color-subtle);
  }

  .lang-flag-current {
    font-size: 1.05rem;
    line-height: 1;
  }

  .lang-label {
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .chevron {
    opacity: 0.5;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .lang-selector.open .chevron {
    transform: rotate(180deg);
  }

  /* ─── Dropdown ──────────────────────────────────────────────────────────── */
  .lang-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 190px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 0.4rem;
    list-style: none;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 16px 40px -4px rgba(0, 0, 0, 0.18);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px) scale(0.98);
    transform-origin: top right;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s;
    z-index: 200;
  }

  .lang-selector.open .lang-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  /* ─── Dropdown item ─────────────────────────────────────────────────────── */
  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.65rem;
    border-radius: 9px;
    cursor: pointer;
    transition: background 0.12s ease;
    user-select: none;
  }

  .lang-option:hover {
    background: var(--color-skill-bg);
  }

  .lang-option.active {
    background: var(--color-skill-bg);
  }

  .lang-flag {
    font-size: 1.3rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .lang-text {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    flex: 1;
    min-width: 0;
  }

  .lang-code {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .lang-name {
    font-size: 0.7rem;
    color: var(--color-subtle);
    line-height: 1.2;
  }

  .check-icon {
    color: var(--color-accent-from);
    flex-shrink: 0;
    margin-left: auto;
  }

  /* ─── Responsive ────────────────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .nav-controls {
      gap: 0.35rem;
    }

    .theme-btn {
      width: 36px;
      height: 36px;
    }

    .lang-current {
      height: 36px;
      padding: 0 0.55rem;
      gap: 0.3rem;
    }

    .lang-label {
      display: none;
    }

    .lang-flag-current {
      font-size: 1.15rem;
    }

    .chevron {
      display: none;
    }
  }
</style>

<script>
  // ─── Theme icon sync ─────────────────────────────────────────────────────
  // CSS scoped cannot reach html[data-theme], so we control icons via JS only.
  const iconSun  = document.getElementById('icon-sun')  as SVGElement | null;
  const iconMoon = document.getElementById('icon-moon') as SVGElement | null;

  function syncIcons(theme: string) {
    if (!iconSun || !iconMoon) return;
    if (theme === 'dark') {
      iconSun.style.display  = 'block'; // dark → show sun (switch to light)
      iconMoon.style.display = 'none';
    } else {
      iconSun.style.display  = 'none';
      iconMoon.style.display = 'block'; // light → show moon (switch to dark)
    }
  }

  // Sync on load
  const currentTheme = document.documentElement.getAttribute('data-theme') ?? 'dark';
  syncIcons(currentTheme);

  // ─── Theme toggle ────────────────────────────────────────────────────────
  const themeBtn = document.getElementById('theme-toggle');

  themeBtn?.addEventListener('click', () => {
    const html    = document.documentElement;
    const current = html.getAttribute('data-theme') ?? 'dark';
    const next    = current === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    syncIcons(next);
  });

  // ─── Scroll detection ────────────────────────────────────────────────────
  const header = document.getElementById('header');

  function handleScroll() {
    header?.classList.toggle('scrolled', window.scrollY > 0);
  }

  handleScroll();
  window.addEventListener('scroll', handleScroll, { passive: true });

  // ─── Language selector ───────────────────────────────────────────────────
  const langSelector = document.getElementById('lang-selector');
  const langBtn      = document.getElementById('lang-btn');
  const langDropdown = document.getElementById('lang-dropdown');

  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = langSelector?.classList.toggle('open');
    langBtn.setAttribute('aria-expanded', String(isOpen));
  });

  document.addEventListener('click', () => {
    langSelector?.classList.remove('open');
    langBtn?.setAttribute('aria-expanded', 'false');
  });

  langDropdown?.querySelectorAll('.lang-option').forEach((opt) => {
    opt.addEventListener('click', (e) => {
      e.stopPropagation();
      const code = (opt as HTMLElement).dataset.lang;
      if (code) {
        localStorage.setItem('lang', code);
        const url = new URL(window.location.href);
        url.searchParams.set('lang', code);
        window.location.href = url.toString();
      }
    });
  });
</script>
