---
import { translations, localeLabels, localeNames } from '../i18n/translations';
import type { Locale } from '../i18n/translations';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

// Mapeamento de bandeiras para cada idioma
const localeFlags: Record<Locale, string> = {
  'en': '🇺🇸',
  'pt-br': '🇧🇷',
  'es': '🇪🇸',
  'zh': '🇨🇳',
  'it': '🇮🇹'
};
---

<header class="header" id="header">
  <div class="container nav-inner">

    <!-- Logo -->
    <a href="/" class="nav-logo">Matheus Palmieri</a>

    <!-- Right controls -->
    <div class="nav-controls">

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        class="theme-btn"
        aria-label="Toggle theme"
        title="Toggle dark/light mode"
      >
        <svg class="theme-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <!-- Sun icon -->
          <g class="sun-icon">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </g>
          <!-- Moon icon -->
          <path class="moon-icon" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <!-- Language selector -->
      <div class="lang-selector" id="lang-selector">
        <button class="lang-current" id="lang-btn" aria-haspopup="listbox" aria-expanded="false">
          <span class="lang-flag-current">{localeFlags[lang]}</span>
          <span class="lang-label">{localeLabels[lang]}</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="chevron">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <ul class="lang-dropdown" role="listbox" id="lang-dropdown">
          {Object.entries(localeLabels).map(([code, label]) => (
            <li
              role="option"
              data-lang={code}
              class={`lang-option ${code === lang ? 'active' : ''}`}
              aria-selected={code === lang}
            >
              <div class="lang-option-content">
                <span class="lang-flag">{localeFlags[code as Locale]}</span>
                <div class="lang-text">
                  <span class="lang-code">{label}</span>
                  <span class="lang-name">{localeNames[code as Locale]}</span>
                </div>
              </div>
              {code === lang && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              )}
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</header>

<style>
  /* ─── Header shell ───────────────────────────────────────────────────── */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-header-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }

  .header.scrolled {
    border-bottom-color: var(--color-border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    gap: 1rem;
  }

  /* ─── Logo ─────────────────────────────────────────────────────────────── */
  .nav-logo {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text);
    letter-spacing: -0.01em;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.2s;
  }
  .nav-logo:hover { opacity: 0.7; }

  /* ─── Right controls ───────────────────────────────────────────────────── */
  .nav-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  /* ─── Theme button ─────────────────────────────────────────────────────── */
  .theme-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }
  
  .theme-btn:hover {
    color: var(--color-text);
    background: var(--color-skill-bg);
    border-color: var(--color-border);
    transform: scale(1.05);
  }

  .theme-btn:active {
    transform: scale(0.95);
  }

  .theme-icon {
    transition: transform 0.3s ease;
  }

  .theme-btn:hover .theme-icon {
    transform: rotate(20deg);
  }

  /* Show/hide sun & moon based on theme with smooth transition */
  .sun-icon,
  .moon-icon {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  [data-theme='dark'] .sun-icon {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
  
  [data-theme='dark'] .moon-icon {
    opacity: 0;
    transform: scale(0.5) rotate(-90deg);
  }

  [data-theme='light'] .sun-icon {
    opacity: 0;
    transform: scale(0.5) rotate(90deg);
  }
  
  [data-theme='light'] .moon-icon {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }

  /* ─── Language selector ─────────────────────────────────────────────────── */
  .lang-selector { 
    position: relative;
  }

  .lang-current {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    height: 40px;
    transition: all 0.2s ease;
  }
  
  .lang-current:hover {
    background: var(--color-skill-bg);
    border-color: var(--color-border);
    transform: scale(1.02);
  }

  .lang-flag-current {
    font-size: 1.1rem;
    line-height: 1;
  }

  .lang-label {
    font-weight: 600;
    color: var(--color-text);
  }

  .chevron { 
    transition: transform 0.2s ease;
    opacity: 0.6;
  }
  
  .lang-selector.open .chevron { 
    transform: rotate(180deg); 
  }

  .lang-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 200px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 0.5rem;
    list-style: none;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 200;
  }
  
  .lang-selector.open .lang-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .lang-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  
  .lang-option:hover {
    background: var(--color-skill-bg);
  }
  
  .lang-option.active {
    background: var(--color-skill-bg);
  }

  .lang-option-content {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
  }

  .lang-flag {
    font-size: 1.25rem;
    line-height: 1;
  }

  .lang-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .lang-code {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.2;
  }

  .lang-name {
    font-size: 0.7rem;
    color: var(--color-subtle);
    line-height: 1.2;
  }

  .check-icon {
    color: var(--color-accent-from);
    flex-shrink: 0;
  }

  /* ─── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .nav-controls { 
      gap: 0.4rem; 
    }

    .theme-btn,
    .lang-current {
      width: 36px;
      height: 36px;
    }

    .lang-label {
      display: none;
    }

    .lang-current {
      padding: 0.5rem;
      justify-content: center;
    }

    .lang-flag-current {
      font-size: 1.2rem;
    }
  }
</style>

<script>
  // ─── Scroll detection for border ─────────────────────────────────────────
  const header = document.getElementById('header');
  
  function handleScroll() {
    if (window.scrollY > 0) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  }

  // Initial check
  handleScroll();
  
  // Listen to scroll
  window.addEventListener('scroll', handleScroll, { passive: true });

  // ─── Theme toggle ─────────────────────────────────────────────────────────
  const themeBtn = document.getElementById('theme-toggle');
  themeBtn?.addEventListener('click', () => {
    const html    = document.documentElement;
    const current = html.getAttribute('data-theme');
    const next    = current === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });

  // ─── Language selector ────────────────────────────────────────────────────
  const langSelector = document.getElementById('lang-selector');
  const langBtn      = document.getElementById('lang-btn');
  const langDropdown = document.getElementById('lang-dropdown');

  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    langSelector?.classList.toggle('open');
    langBtn.setAttribute(
      'aria-expanded',
      String(langSelector?.classList.contains('open'))
    );
  });

  document.addEventListener('click', () => {
    langSelector?.classList.remove('open');
    langBtn?.setAttribute('aria-expanded', 'false');
  });

  langDropdown?.querySelectorAll('.lang-option').forEach((opt) => {
    opt.addEventListener('click', (e) => {
      e.stopPropagation();
      const code = (opt as HTMLElement).dataset.lang;
      if (code) {
        localStorage.setItem('lang', code);
        const url = new URL(window.location.href);
        url.searchParams.set('lang', code);
        window.location.href = url.toString();
      }
    });
  });
</script>
