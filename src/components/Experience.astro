---

<section id="experience" class="section">
  <h2 class="section-title">Experience</h2>

  <div class="jobs">
    {jobs.map((job) => (
      <article class="job">
        <div class="job-header">
          <div>
            <h3 class="job-company">{job.company}</h3>
            <p class="job-role">{job.role}</p>
          </div>
          <div class="job-meta">
            <span class="job-period">{job.period}</span>
            <span class="job-location">{job.location}</span>
          </div>
        </div>

        <ul class="job-description">
          {job.description.map((item) => (
            <li>{item}</li>
          ))}
        </ul>

        <p class="job-tech">{job.tech}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .section {
    padding: 2.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .section-title {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-subtle);
    margin-bottom: 2rem;
  }

  .jobs {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .job {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .job-company {
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
  }

  .job-role {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-top: 0.1rem;
  }

  .job-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
    flex-shrink: 0;
  }

  .job-period {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .job-location {
    font-size: 0.75rem;
    color: var(--color-subtle);
  }

  .job-description {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .job-description li {
    font-size: 0.875rem;
    color: #c0c0c0;
    line-height: 1.65;
    padding-left: 1rem;
    position: relative;
  }

  .job-description li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-subtle);
    font-size: 0.75rem;
  }

  .job-tech {
    font-size: 0.75rem;
    color: var(--color-subtle);
    font-style: italic;
  }
</style>
