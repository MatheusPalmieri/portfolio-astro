---
import { translations } from '../i18n/translations';
import type { Locale } from '../i18n/translations';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = translations[lang].hero;
---

<section class="hero">
  <p class="greeting">{t.greeting}</p>
  <h1 class="name gradient-text">Matheus Palmieri</h1>
  <p class="role">{t.role}</p>
  <p class="bio" set:html={t.bio.replace('React', '<strong>React</strong>').replace('Next.js', '<strong>Next.js</strong>').replace('TypeScript', '<strong>TypeScript</strong>').replace('Node.js', '<strong>Node.js</strong>').replace('Python', '<strong>Python</strong>')} />

  <div class="links">
    <a href="https://www.linkedin.com/in/matheusandrepalmieri/" target="_blank" rel="noopener">{t.links.linkedin}</a>
    <span class="sep">·</span>
    <a href="https://github.com/MatheusPalmieri" target="_blank" rel="noopener">{t.links.github}</a>
    <span class="sep">·</span>
    <a href="https://matheuspalmieri.netlify.app/" target="_blank" rel="noopener">{t.links.portfolio}</a>
    <span class="sep">·</span>
    <a href="mailto:matheuspalmieridev+cv@gmail.com">{t.links.email}</a>
  </div>

  <div class="skills">
    <p class="skills-label">{t.mainSkills}</p>
    <div class="skills-list">
      <span>React.js</span><span>Node.js</span><span>TypeScript</span>
      <span>Next.js</span><span>NestJS</span><span>Python</span>
      <span>PostgreSQL</span><span>Docker</span><span>AWS</span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 6rem;
    padding-bottom: 3rem;
  }

  .greeting {
    font-size: 1.1rem;
    color: var(--color-muted);
    margin-bottom: 0.25rem;
  }

  .name {
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 600;
    line-height: 1.1;
    margin-bottom: 0.4rem;
    letter-spacing: -0.02em;
  }

  .role {
    font-size: 1.05rem;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
    font-weight: 400;
  }

  .bio {
    font-size: 0.975rem;
    color: var(--color-muted);
    line-height: 1.8;
    margin-bottom: 1.5rem;
    max-width: 680px;
  }

  .bio :global(strong) {
    color: var(--color-text);
    font-weight: 500;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .links a { font-size: 0.875rem; }

  .sep {
    color: var(--color-subtle);
    font-size: 0.75rem;
    user-select: none;
  }

  .skills {
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }

  .skills-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-subtle);
    margin-bottom: 0.75rem;
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skills-list span {
    font-size: 0.8rem;
    color: var(--color-muted);
    background: var(--color-skill-bg);
    border: 1px solid var(--color-skill-border);
    border-radius: 5px;
    padding: 0.2rem 0.65rem;
  }
</style>
