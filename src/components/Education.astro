---
const education = [
  {
    institution: 'Estácio',
    degree: 'Bachelor of Software Engineering',
    period: 'May 2023 — May 2027',
    status: 'In progress',
  },
];

const languages = [
  { lang: 'Portuguese', level: 'Native' },
  { lang: 'English', level: 'Intermediate' },
  { lang: 'Spanish', level: 'Basic' },
];
---

<section id="education" class="section">
  <h2 class="section-title">Education</h2>

  <div class="education-list">
    {education.map((item) => (
      <article class="edu-item">
        <div class="edu-header">
          <div>
            <h3 class="edu-institution">{item.institution}</h3>
            <p class="edu-degree">{item.degree}</p>
          </div>
          <div class="edu-meta">
            <span class="edu-period">{item.period}</span>
            <span class="edu-status">{item.status}</span>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="languages">
    <h2 class="section-title" style="margin-top: 2rem;">Languages</h2>
    <div class="lang-list">
      {languages.map((l) => (
        <div class="lang-item">
          <span class="lang-name">{l.lang}</span>
          <span class="lang-level">{l.level}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: 2.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .section-title {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-subtle);
    margin-bottom: 2rem;
  }

  .education-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .edu-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .edu-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .edu-institution {
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
  }

  .edu-degree {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-top: 0.1rem;
  }

  .edu-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
    flex-shrink: 0;
  }

  .edu-period {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .edu-status {
    font-size: 0.75rem;
    color: var(--color-subtle);
  }

  .languages {
    margin-top: 0.5rem;
  }

  .lang-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .lang-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 220px;
  }

  .lang-name {
    font-size: 0.875rem;
    color: #c0c0c0;
  }

  .lang-level {
    font-size: 0.8rem;
    color: var(--color-subtle);
  }
</style>
